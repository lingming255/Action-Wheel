<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Action_Wheel.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Action_Wheel.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Action Wheel 设置 / Action Wheel Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <!--
        RootGrid.DataContext is the SettingsViewModel (set in the constructor - Window itself is not
        a FrameworkElement in WinUI 3 and has no DataContext), so everything outside a DataTemplate
        binds to the view model. The detail panel in the Buttons section binds its own DataContext to
        ActionsHost.SelectedItem via an ElementName binding instead, which is why its own controls
        bind straight to ActionEditModel properties (Label, KindIndex, ...) rather than reaching
        through the view model.

        The bindings here use classic {Binding} rather than {x:Bind}: this avoids depending on how
        x:Bind behaves when the root element is a Window. Classic binding uses reflection - safe
        while the project publishes with PublishTrimmed=False; if trimming is ever turned on, these
        bindings need to move to x:Bind.
    -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <DataTemplate x:Key="FunctionSuggestionTemplate">
                <Grid Width="420" Padding="4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="{Binding Glyph}" FontSize="16"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <!--
                Every FontIcon in this window draws from the shipped icon font, including this
                window's own furniture - browse, record, undo, redo, the status marker. There are no
                system-icon-font code points left anywhere in the app: a value here is read against
                one font only, so the family is never left to default.
            -->

            <!-- One icon cell in the glyph-picker grid -->
            <DataTemplate x:Key="GlyphChoiceTemplate">
                <Border Width="44" Height="44" ToolTipService.ToolTip="{Binding Tooltip}">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}"
                              Glyph="{Binding Preview}"
                              FontSize="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
            </DataTemplate>

            <!-- A compact row in the left-hand list: just enough to identify and select a button,
                 with full editing living in the detail panel on the right (see DetailPanelBorder's
                 DataContext). -->
            <DataTemplate x:Key="CompactActionRowTemplate">
                <!-- AutomationProperties.Name is required here, not decorative: a Grid of
                     TextBlocks reports nothing to a screen reader by default, unlike the old
                     row template where the Label TextBox and Kind ComboBox each carried their
                     own accessible name. -->
                <Grid ColumnSpacing="10" Padding="10,8" AutomationProperties.Name="{Binding PositionName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF047;" FontSize="12"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              ToolTipService.ToolTip="拖动以移动按钮 / Drag to move this button"/>

                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18"
                            Background="{Binding BackgroundColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}">
                        <ContentPresenter Content="{Binding IconSource, Mode=OneWay, Converter={StaticResource IconPreviewConverter}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="{Binding PositionName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="{Binding Label}"/>
                    </StackPanel>

                    <FontIcon Grid.Column="3"
                              FontFamily="{StaticResource IconFontFamily}"
                              FontSize="13"
                              VerticalAlignment="Center"
                              Glyph="{Binding StatusGlyph, Mode=OneWay}"
                              Foreground="{Binding StatusColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                              Visibility="{Binding HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              ToolTipService.ToolTip="{Binding StatusTooltip, Mode=OneWay}"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ActionDetailTemplate">
                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                                <StackPanel Spacing="18">

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF047;" FontSize="13"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PositionName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TagCaption}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Width="36" Height="34" Padding="0" Tag="{Binding}"
                                                    Click="TestAction_Click"
                                                    AutomationProperties.Name="测试此动作 / Test this action"
                                                    ToolTipService.ToolTip="测试此动作，无需保存 / Test this action without saving">
                                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF04B;" FontSize="14"/>
                                            </Button>
                                            <Button Width="36" Height="34" Padding="0"
                                                    Command="{Binding ResetCommand}"
                                                    AutomationProperties.Name="将此按钮恢复为默认值 / Reset this button to its default"
                                                    ToolTipService.ToolTip="将此按钮恢复为默认值 / Reset this button to its default">
                                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF021;" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Icon, name, type -->
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Width="56" Height="56" Padding="0" CornerRadius="28"
                                                Background="{Binding BackgroundColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                                Content="{Binding IconSource, Mode=OneWay, Converter={StaticResource IconPreviewConverter}}"
                                                Tag="{Binding}"
                                                Click="PickGlyph_Click"
                                                AutomationProperties.Name="选择图标 / Choose an icon"
                                                ToolTipService.ToolTip="选择图标 / Choose an icon"/>
                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <TextBox PlaceholderText="提示文字 / Tooltip text"
                                                     Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      SelectedIndex="{Binding KindIndex, Mode=TwoWay}">
                                                <ComboBoxItem><TextBlock Text="无操作 / Do nothing" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem><TextBlock Text="发送快捷键 / Send shortcut" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem><TextBlock Text="打开应用 / 文件 / Open app / file" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem><TextBlock Text="Windows 功能 / Windows function" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem IsEnabled="{Binding CanBeGroup, Mode=OneWay}"
                                                              ToolTipService.ToolTip="中心按钮不能设为分组。 / The centre button cannot be a group."><TextBlock Text="分组（最多5个按钮） / Group (up to 5 buttons)" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem><TextBlock Text="复制文字 / Copy text" TextWrapping="Wrap"/></ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Value and its type-specific controls -->
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 VerticalAlignment="Center"
                                                 IsEnabled="{Binding IsValueEnabled, Mode=OneWay}"
                                                 Visibility="{Binding IsFunction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                 PlaceholderText="{Binding ValuePlaceholder, Mode=OneWay}"
                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <AutoSuggestBox Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"
                                                        Visibility="{Binding IsFunction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        ItemsSource="{Binding FunctionSuggestions, Mode=OneWay}"
                                                        ItemTemplate="{StaticResource FunctionSuggestionTemplate}"
                                                        Text="{Binding FunctionQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SuggestionChosen="FunctionSuggestion_Chosen"
                                                        GotFocus="FunctionBox_OpenSuggestions"
                                                        Tapped="FunctionBox_OpenSuggestions"
                                                        PlaceholderText="搜索 Windows 功能… / Search Windows functions…"/>

                                        <ToggleButton Grid.Column="1" Width="40" Height="34"
                                                      Padding="0"
                                                      Tag="{Binding}"
                                                      Checked="Record_Checked"
                                                      Unchecked="Record_Unchecked"
                                                      IsEnabled="{Binding CanRecord, Mode=OneWay}"
                                                      Visibility="{Binding IsGroup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                      AutomationProperties.Name="录制按键 / Record a key press"
                                                      ToolTipService.ToolTip="录制按键 / Record a key press">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF11C;" FontSize="14"/>
                                        </ToggleButton>
                                        <Button Grid.Column="2" Width="40" Height="34"
                                                Padding="0"
                                                Tag="{Binding}"
                                                Click="Browse_Click"
                                                IsEnabled="{Binding CanBrowse, Mode=OneWay}"
                                                Visibility="{Binding IsGroup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                AutomationProperties.Name="浏览文件 / Browse for a file"
                                                ToolTipService.ToolTip="浏览文件 / Browse for a file">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF115;" FontSize="14"/>
                                        </Button>
                                        <Button Grid.Column="1" Grid.ColumnSpan="2" Padding="10,0" Height="34"
                                                Tag="{Binding}"
                                                Click="EditGroup_Click"
                                                AutomationProperties.Name="编辑分组 / Edit group"
                                                Visibility="{Binding IsGroup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                ToolTipService.ToolTip="为此分组选择最多5个按钮 / Choose this group's up to 5 buttons">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF045;" FontSize="13"/>
                                                <TextBlock Text="{Binding EditGroupText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{Binding HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                                  Glyph="{Binding StatusGlyph, Mode=OneWay}"
                                                  Foreground="{Binding StatusColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"/>
                                        <TextBlock Text="{Binding StatusTooltip, Mode=OneWay}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Icon file -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="图标文件 / Icon file" Style="{StaticResource SectionHeaderTextStyle}" TextWrapping="Wrap"/>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     PlaceholderText="无文件，使用字形图标 / none — using the glyph"
                                                     Text="{Binding IconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Width="36" Height="32" Padding="0"
                                                    Tag="{Binding}" Click="BrowseSvg_Click"
                                                    AutomationProperties.Name="选择图标文件 / Choose an icon file"
                                                    ToolTipService.ToolTip="选择 .svg、.png 或 .ico 文件 / Choose an .svg, .png or .ico file">
                                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF115;" FontSize="13"/>
                                            </Button>
                                            <Button Grid.Column="2" Width="36" Height="32" Padding="0"
                                                    Command="{Binding ClearIconCommand}"
                                                    IsEnabled="{Binding HasIconFile, Mode=OneWay}"
                                                    AutomationProperties.Name="恢复字形图标 / Back to the glyph icon"
                                                    ToolTipService.ToolTip="恢复字形图标 / Back to the glyph icon">
                                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00D;" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Icon text -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="文字图标 / Icon text" Style="{StaticResource SectionHeaderTextStyle}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Text="用短词、字母或表情代替图片；已选图标文件时优先使用文件。 / A short word, letter or emoji instead of a picture. An icon file above still wins over this."/>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     MaxLength="6"
                                                     PlaceholderText="无文件，使用字形图标 / none — using the glyph"
                                                     Text="{Binding IconText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Width="36" Height="32" Padding="0"
                                                    Command="{Binding ClearIconTextCommand}"
                                                    IsEnabled="{Binding HasIconText, Mode=OneWay}"
                                                    AutomationProperties.Name="清除文字并恢复字形图标 / Back to the glyph icon from text"
                                                    ToolTipService.ToolTip="恢复字形图标 / Back to the glyph icon">
                                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00D;" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Colours & shadow -->
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="颜色与阴影 / Colours &amp; shadow" Style="{StaticResource SectionHeaderTextStyle}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Button Width="56" Height="34" Padding="0"
                                                        Tag="{Binding}" Click="PickForeground_Click"
                                                        AutomationProperties.Name="图标颜色 / Icon colour"
                                                        ToolTipService.ToolTip="图标颜色 / Icon colour">
                                                    <Border Width="26" Height="18" CornerRadius="3"
                                                            BorderThickness="1"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            Background="{Binding ForegroundColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"/>
                                                </Button>
                                                <TextBlock Text="图标 / Icon" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Button Width="56" Height="34" Padding="0"
                                                        Tag="{Binding}" Click="PickBackground_Click"
                                                        AutomationProperties.Name="按钮颜色 / Button colour"
                                                        ToolTipService.ToolTip="按钮颜色 / Button colour">
                                                    <Border Width="26" Height="18" CornerRadius="3"
                                                            BorderThickness="1"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            Background="{Binding BackgroundColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"/>
                                                </Button>
                                                <TextBlock Text="按钮 / Button" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Button Width="56" Height="34" Padding="0"
                                                        Tag="{Binding}" Click="PickShadow_Click"
                                                        AutomationProperties.Name="阴影颜色 / Shadow colour"
                                                        ToolTipService.ToolTip="阴影颜色 / Shadow colour">
                                                    <Border Width="26" Height="18" CornerRadius="3"
                                                            BorderThickness="1"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            Background="{Binding ShadowColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"/>
                                                </Button>
                                                <TextBlock Text="阴影 / Shadow" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch VerticalAlignment="Center" Margin="8,0,0,0"
                                                          IsOn="{Binding ShadowEnabled, Mode=TwoWay}" OnContent="阴影开 / Shadow on" OffContent="阴影关 / Shadow off"
                                                          ToolTipService.ToolTip="启用按钮阴影 / Enable button shadow"/>
                                        </StackPanel>
                                        <Grid ColumnSpacing="10" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <FontIcon Grid.Row="0" Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF043;" FontSize="13"
                                                      VerticalAlignment="Center" ToolTipService.ToolTip="阴影不透明度 / Shadow opacity"/>
                                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.05"
                                                    TickFrequency="0.25" VerticalAlignment="Center"
                                                    Value="{Binding ShadowOpacity, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="阴影不透明度（0–1） / Shadow opacity (0–1)"/>
                                            <Border Grid.Row="0" Grid.Column="2" Height="26" CornerRadius="4" BorderThickness="1"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    ToolTipService.ToolTip="当前阴影不透明度 / Current shadow opacity">
                                                <TextBlock Text="{Binding ShadowOpacityText, Mode=OneWay}" FontSize="12"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>

                                            <FontIcon Grid.Row="1" Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00B8;" FontSize="13"
                                                      VerticalAlignment="Center" ToolTipService.ToolTip="阴影模糊 / Shadow blur"/>
                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="64" StepFrequency="1"
                                                    TickFrequency="8" VerticalAlignment="Center"
                                                    Value="{Binding ShadowBlur, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="阴影模糊 / Shadow blur"/>
                                            <Border Grid.Row="1" Grid.Column="2" Height="26" CornerRadius="4" BorderThickness="1"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    ToolTipService.ToolTip="当前阴影模糊 / Current shadow blur">
                                                <TextBlock Text="{Binding ShadowBlurText, Mode=OneWay}" FontSize="12"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>

                                            <FontIcon Grid.Row="2" Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF07E;" FontSize="13"
                                                      VerticalAlignment="Center" ToolTipService.ToolTip="阴影水平偏移 / Shadow horizontal offset"/>
                                            <Slider Grid.Row="2" Grid.Column="1" Minimum="-50" Maximum="50" StepFrequency="1"
                                                    TickFrequency="10" VerticalAlignment="Center"
                                                    Value="{Binding ShadowOffsetX, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="阴影水平偏移 / Shadow horizontal offset"/>
                                            <Border Grid.Row="2" Grid.Column="2" Height="26" CornerRadius="4" BorderThickness="1"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    ToolTipService.ToolTip="当前阴影水平偏移 / Current shadow horizontal offset">
                                                <TextBlock Text="{Binding ShadowOffsetXText, Mode=OneWay}" FontSize="12"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>

                                            <FontIcon Grid.Row="3" Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF07D;" FontSize="13"
                                                      VerticalAlignment="Center" ToolTipService.ToolTip="阴影垂直偏移 / Shadow vertical offset"/>
                                            <Slider Grid.Row="3" Grid.Column="1" Minimum="-50" Maximum="50" StepFrequency="1"
                                                    TickFrequency="10" VerticalAlignment="Center"
                                                    Value="{Binding ShadowOffsetY, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="阴影垂直偏移 / Shadow vertical offset"/>
                                            <Border Grid.Row="3" Grid.Column="2" Height="26" CornerRadius="4" BorderThickness="1"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    ToolTipService.ToolTip="当前阴影垂直偏移 / Current shadow vertical offset">
                                                <TextBlock Text="{Binding ShadowOffsetYText, Mode=OneWay}" FontSize="12"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Icon position -->
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="图标位置 / Icon position" Style="{StaticResource SectionHeaderTextStyle}" TextWrapping="Wrap"/>
                                        <ToggleSwitch IsOn="{Binding IconTint, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanTintIcon, Mode=OneWay}"
                                                      OnContent="图标颜色 / Icon colour" OffContent="文件原色 / File colours"
                                                      ToolTipService.ToolTip="将 SVG 染为所选图标颜色；仅 SVG 支持重新着色。 / Recolour an .svg to the icon colour. Only an .svg can be recoloured."/>
                                        <Grid ColumnSpacing="10" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <FontIcon Grid.Row="0" Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF065;" FontSize="13"
                                                      VerticalAlignment="Center" ToolTipService.ToolTip="图标大小 / Icon size"/>
                                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0.25" Maximum="3" StepFrequency="0.05"
                                                    TickFrequency="0.25" SnapsTo="StepValues" VerticalAlignment="Center"
                                                    Value="{Binding IconScale, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="图标大小（0.25×至3×） / Icon size (0.25× to 3×)"/>
                                            <Border Grid.Row="0" Grid.Column="2" Height="26" CornerRadius="4" BorderThickness="1"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    ToolTipService.ToolTip="当前图标大小 / Current icon size">
                                                <TextBlock Text="{Binding IconScaleText, Mode=OneWay}" FontSize="12"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>

                                            <FontIcon Grid.Row="1" Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF07E;" FontSize="13"
                                                      VerticalAlignment="Center" ToolTipService.ToolTip="图标水平位置 / Icon horizontal position"/>
                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="-50" Maximum="50" StepFrequency="0.25"
                                                    TickFrequency="5" Value="{Binding IconOffsetX, Mode=TwoWay}"
                                                    IsEnabled="{Binding HasIconFile}"
                                                    VerticalAlignment="Center" ToolTipService.ToolTip="水平移动图标 / Move icon horizontally"/>
                                            <Border Grid.Row="1" Grid.Column="2" Height="26" CornerRadius="4" BorderThickness="1"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    ToolTipService.ToolTip="图标水平偏移 / Icon horizontal offset">
                                                <TextBlock Text="{Binding IconOffsetXText, Mode=OneWay}" FontSize="12"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>

                                            <FontIcon Grid.Row="2" Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF07D;" FontSize="13"
                                                      VerticalAlignment="Center" ToolTipService.ToolTip="图标垂直位置 / Icon vertical position"/>
                                            <Slider Grid.Row="2" Grid.Column="1" Minimum="-50" Maximum="50" StepFrequency="0.25"
                                                    TickFrequency="5" Value="{Binding IconOffsetY, Mode=TwoWay}"
                                                    IsEnabled="{Binding HasIconFile}"
                                                    VerticalAlignment="Center" ToolTipService.ToolTip="垂直移动图标 / Move icon vertically"/>
                                            <Border Grid.Row="2" Grid.Column="2" Height="26" CornerRadius="4" BorderThickness="1"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    ToolTipService.ToolTip="图标垂直偏移 / Icon vertical offset">
                                                <TextBlock Text="{Binding IconOffsetYText, Mode=OneWay}" FontSize="12"
                                                           TextAlignment="Center" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Hold action -->
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="长按动作 / Hold action" Style="{StaticResource SectionHeaderTextStyle}" TextWrapping="Wrap"/>
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF05A;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      ToolTipService.ToolTip="按住约半秒触发的可选动作；多数按钮只需设置上方的点击动作。 / What this button does when pressed and held (about half a second), instead of clicked. Optional - most buttons need only the action above."/>
                                        </StackPanel>
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <ComboBox Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch"
                                                      SelectedIndex="{Binding HoldKindIndex, Mode=TwoWay}"
                                                      ToolTipService.ToolTip="长按动作 / Hold action">
                                                <ComboBoxItem><TextBlock Text="无长按动作 / No hold action" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem><TextBlock Text="发送快捷键 / Send shortcut" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem><TextBlock Text="打开应用 / 文件 / Open app / file" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem><TextBlock Text="Windows 功能 / Windows function" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem IsEnabled="False"><TextBlock Text="分组 / Group" TextWrapping="Wrap"/></ComboBoxItem>
                                                <ComboBoxItem><TextBlock Text="复制文字 / Copy text" TextWrapping="Wrap"/></ComboBoxItem>
                                            </ComboBox>
                                            <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                                     IsEnabled="{Binding IsHoldValueEnabled, Mode=OneWay}"
                                                     Visibility="{Binding IsHoldFunction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                     PlaceholderText="{Binding HoldValuePlaceholder, Mode=OneWay}"
                                                     Text="{Binding HoldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                                      Visibility="{Binding IsHoldFunction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ItemsSource="{Binding HoldFunctionChoices, Mode=OneWay}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding HoldValue, Mode=TwoWay}"
                                                      PlaceholderText="选择功能 / Choose a function"/>
                                            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                                                     IsEnabled="{Binding CanBrowseHold, Mode=OneWay}"
                                                     PlaceholderText="参数（仅用于打开应用 / 文件） / Arguments (only for Open app / file)"
                                                     ToolTipService.ToolTip="命令行参数，仅用于打开应用 / 文件 / Command-line arguments, only for Open app / file"
                                                     Text="{Binding HoldArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="32" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,140,0"
                        VerticalAlignment="Center">
                <Image Source="/icon.ico" Width="16" Height="16"/>
                <TextBlock Text="Action Wheel — 设置 / Action Wheel — Settings" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Slim header: just the title, description and the whole-ring presets. Profile
             management and backup moved to their own section (see "Profiles & backup" below) -
             this used to also carry all of that, which is what made it grow every time a feature
             was added to it. -->
        <StackPanel Grid.Row="1" Padding="24,6,24,10" Spacing="2">
            <TextBlock Text="按钮设置 / Button settings" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="每个按钮可发送快捷键，或打开应用、文件、文件夹和网址。拖动列表项调整位置，保存后下次打开轮盘生效。 / Each button can send a keyboard shortcut or open an app, file, folder or URL. Drag a row to move that button around the ring. Save applies the changes to the next menu you open."/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                <TextBlock Text="外观 / Appearance" VerticalAlignment="Bottom" Margin="0,0,0,9"
                           ToolTipService.ToolTip="将外观预设应用到全部9个按钮。 / Apply an appearance preset to all nine buttons." TextWrapping="Wrap"/>
                <Button Content="浅色 / Light" Command="{Binding LightPresetCommand}" VerticalAlignment="Bottom"
                        Background="#FFF7F7F7" Foreground="#FF202020"
                        BorderBrush="#FFB8B8B8" BorderThickness="1"
                        ToolTipService.ToolTip="将浅色预设应用到全部按钮。 / Apply the light preset to all buttons."/>
                <Button Content="深色 / Dark" Command="{Binding DarkPresetCommand}" VerticalAlignment="Bottom"
                        Background="#FF242424" Foreground="#FFF5F5F5"
                        BorderBrush="#FF5A5A5A" BorderThickness="1"
                        ToolTipService.ToolTip="将深色预设应用到全部按钮。 / Apply the dark preset to all buttons."/>
                <Button Content="多彩 / Colourful" Command="{Binding ColorfulPresetCommand}" VerticalAlignment="Bottom"
                        Foreground="White" BorderBrush="#668B5CF6" BorderThickness="1"
                        ToolTipService.ToolTip="为每个按钮应用不同的强调色。 / Apply a different accent colour to each button.">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF5B8DEF" Offset="0"/>
                            <GradientStop Color="#FF8B5CF6" Offset="0.35"/>
                            <GradientStop Color="#FFEC4899" Offset="0.68"/>
                            <GradientStop Color="#FFF97316" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Three sections, Windows-Settings-style left rail. Switching between them just toggles
             Visibility on three pre-built panels (see SectionsNav_SelectionChanged) rather than a
             Frame/Page navigation stack - there are only three, none of them are ever created more
             than once, and nothing about them needs back/forward history. -->
        <NavigationView x:Name="SectionsNav" Grid.Row="2"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsTabStop="False"
                        OpenPaneLength="270"
                        SelectionChanged="SectionsNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="按钮&#x0a;Buttons" Tag="Buttons" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF009;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观与触发&#x0a;Appearance &amp; trigger" Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF140;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="配置与备份&#x0a;Profiles &amp; backup" Tag="Profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF019;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- ============================= Buttons ============================= -->
                <Grid x:Name="ButtonsSection" ColumnSpacing="16" Padding="16,12,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Left: one compact line per button. CanReorderItems/CanDragItems unchanged
                         from before - this is still how a button's ring position is changed. -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="9个按钮，拖动排序 / 9 buttons — drag to reorder" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,6" TextWrapping="Wrap"/>
                        <ListView x:Name="ActionsHost"
                                  Grid.Row="1"
                                  ItemTemplate="{StaticResource CompactActionRowTemplate}"
                                  SelectionMode="Single"
                                  CanReorderItems="True"
                                  CanDragItems="True"
                                  AllowDrop="True"
                                  IsItemClickEnabled="False"
                                  Padding="0,0,0,12">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,2"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>

                    <!-- Right: preview, then everything about the selected button. -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,16">
                        <StackPanel Spacing="14" MaxWidth="700">

                            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="预览 / Preview" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        <Canvas x:Name="PreviewCanvas" Width="230" Height="230"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Text="预览包含尚未保存的更改。点击预览按钮或左侧列表项，在下方编辑；第一项是中心按钮。 / This is the ring as it will look with your unsaved changes. Click a button here, or a row on the left, to edit it below. The first row is the centre button."/>
                                </Grid>
                            </Border>

                            <!-- Bound via ContentControl+DataTemplate rather than a plain
                                 Border.DataContext override: that pattern quietly defeated
                                 Verify-Bindings.ps1, which only recognises DataTemplate
                                 regions as binding to something other than the window's own
                                 SettingsViewModel. See the scope map in Verify-Bindings.ps1. -->
                            <ContentControl Content="{Binding SelectedItem, ElementName=ActionsHost}"
                                            ContentTemplate="{StaticResource ActionDetailTemplate}"
                                            HorizontalContentAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============================= Appearance & trigger ============================= -->
                <ScrollViewer x:Name="AppearanceSection" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="20,12,20,20">
                    <StackPanel Spacing="16" MaxWidth="900">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF245;" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="鼠标触发 / Open-menu mouse trigger" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <FontIcon Grid.Column="2" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF05A;" FontSize="13"
                                                  Margin="4,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  ToolTipService.ToolTip="鼠标组合键须同时满足时间和移动限制。应急触发：Ctrl+Alt+Space。 / Chord triggers must meet both limits. Emergency trigger: Ctrl+Alt+Space."/>
                                    </Grid>
                                    <ComboBox HorizontalAlignment="Stretch"
                                              SelectedIndex="{Binding TriggerIndex, Mode=TwoWay}"
                                              ToolTipService.ToolTip="选择打开轮盘的鼠标手势；始终可用 Ctrl+Alt+Space 应急触发。 / Choose the mouse gesture that opens the radial menu. Ctrl+Alt+Space always remains available as an emergency trigger.">
                                        <ComboBoxItem><TextBlock Text="鼠标中键 / Middle mouse button" TextWrapping="Wrap"/></ComboBoxItem>
                                        <ComboBoxItem><TextBlock Text="按住右键，再按左键 / Hold right + press left" TextWrapping="Wrap"/></ComboBoxItem>
                                        <ComboBoxItem><TextBlock Text="按住左键，再按右键 / Hold left + press right" TextWrapping="Wrap"/></ComboBoxItem>
                                        <ComboBoxItem><TextBlock Text="鼠标侧键4（后退） / Mouse Button 4 (Back)" TextWrapping="Wrap"/></ComboBoxItem>
                                        <ComboBoxItem><TextBlock Text="鼠标侧键5（前进） / Mouse Button 5 (Forward)" TextWrapping="Wrap"/></ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Text="{Binding TriggerDescription, Mode=OneWay}"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <Slider Header="时限（ms）&#x0a;Timeout (ms)"
                                                    Minimum="200" Maximum="2000" StepFrequency="50" TickFrequency="450"
                                                    Value="{Binding ChordTimeoutMs, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="按下两个鼠标键之间允许的最长间隔；调低可减少误触。 / Maximum delay between pressing the first and second mouse buttons. Lower values reduce accidental activation."/>
                                            <TextBlock Text="{Binding ChordTimeoutMsText, Mode=OneWay}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <Slider Header="移动（px）&#x0a;Movement (px)"
                                                    Minimum="2" Maximum="100" StepFrequency="1" TickFrequency="20"
                                                    Value="{Binding MovementThreshold, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="完成鼠标组合键时允许的最大位移；调低需更稳定地操作。 / Maximum pointer movement allowed while completing a mouse chord. Lower values make the chord more deliberate."/>
                                            <TextBlock Text="{Binding MovementThresholdText, Mode=OneWay}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF140;" FontSize="14"/>
                                        <TextBlock Grid.Column="1" Text="轮盘大小与动画 / Ring size and animation" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <FontIcon Grid.Column="2" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF05A;" FontSize="13"
                                                  Margin="4,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  ToolTipService.ToolTip="这些偏好应用到所有配置，不属于共享的按钮方案。 / These apply to every profile - they are your preference, not part of a shared button set."/>
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- This order must match SettingsViewModel.AnimationOrder, which maps it
                                             to the RingAnimation enum - see the original remark this preserves. -->
                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" Header="展开动画&#x0a;Opening animation"
                                                  SelectedIndex="{Binding RingAnimationIndex, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="轮盘出现的方式；默认时长下约200ms完成，不延迟点击。 / How the ring appears. Every option finishes within about 200 ms at the default effect duration, so none of them delays a click.">
                                            <ComboBoxItem><TextBlock Text="无（立即显示） / None (instant)" TextWrapping="Wrap"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="淡入与缩放 / Fade and scale" TextWrapping="Wrap"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="弹出 / Pop" TextWrapping="Wrap"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="从中心散开 / Radiate from centre" TextWrapping="Wrap"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="从外侧聚拢 / Converge from outside" TextWrapping="Wrap"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="顺时针扫入 / Clockwise sweep" TextWrapping="Wrap"/></ComboBoxItem>
                                            <ComboBoxItem><TextBlock Text="逆时针扫入 / Counter-clockwise sweep" TextWrapping="Wrap"/></ComboBoxItem>
                                        </ComboBox>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Width="36" Height="32" Padding="0"
                                                Command="{Binding PlayAnimationCommand}"
                                                AutomationProperties.Name="播放展开动画 / Play the opening animation"
                                                ToolTipService.ToolTip="在上方预览中重播动画。 / Play the animation again in the preview above.">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF04B;" FontSize="13"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{Binding RingAnimationDescription, Mode=OneWay}"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <Slider Header="按钮大小&#x0a;Button size"
                                                    Minimum="{Binding MinButtonSize, Mode=OneWay}"
                                                    Maximum="{Binding MaxButtonSize, Mode=OneWay}"
                                                    StepFrequency="2"
                                                    Value="{Binding ButtonSize, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="外圈按钮直径，单位为设备独立像素；中心按钮和图标同步缩放。 / Diameter of each outer button, in device-independent pixels. The centre button and the icons scale with it."/>
                                            <TextBlock Text="{Binding ButtonSizeText, Mode=OneWay}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <Slider Header="距中心距离&#x0a;Distance from centre"
                                                    Minimum="{Binding MinOrbitRadius, Mode=OneWay}"
                                                    Maximum="{Binding MaxOrbitRadius, Mode=OneWay}"
                                                    StepFrequency="4"
                                                    Value="{Binding OrbitRadius, Mode=TwoWay}"
                                                    ToolTipService.ToolTip="从轮盘中心到外圈按钮的距离。按钮增大时最小距离随之增大以避免相碰；窗口会随轮盘扩展。 / Distance from the ring's centre to each outer button. The lower limit rises as the buttons grow, so they never touch; the overlay window grows with the ring, so the upper limit does not move."/>
                                            <TextBlock Text="{Binding OrbitRadiusText, Mode=OneWay}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="快 / Fast" VerticalAlignment="Bottom" Margin="0,0,0,7"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        <Slider Grid.Column="1" Header="动画时长&#x0a;Effect duration" VerticalAlignment="Bottom"
                                                Minimum="{Binding MinAnimationDurationMs, Mode=OneWay}"
                                                Maximum="{Binding MaxAnimationDurationMs, Mode=OneWay}"
                                                StepFrequency="10" TickFrequency="100" TickPlacement="Outside"
                                                Value="{Binding AnimationDurationMs, Mode=TwoWay}"
                                                ToolTipService.ToolTip="展开动画的总时长，默认200ms；数值越小越快。 / How long the opening animation takes to finish, in milliseconds. 200 ms is the tuned default; lower plays faster, higher plays slower."/>
                                        <TextBlock Grid.Column="2" Text="慢 / Slow" VerticalAlignment="Bottom" Margin="0,0,0,7"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                        <Border Grid.Column="3" Width="56" Height="32" CornerRadius="4" BorderThickness="1"
                                                VerticalAlignment="Bottom"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                ToolTipService.ToolTip="当前动画时长 / Current effect duration">
                                            <TextBlock Text="{Binding AnimationDurationMsText, Mode=OneWay}" FontSize="12"
                                                       TextAlignment="Center" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="轮盘音效 / Wheel sounds" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <ToggleSwitch Header="展开、切换、确认与取消&#x0a;Open, switch, confirm and cancel"
                                              IsOn="{Binding WheelSoundsEnabled, Mode=TwoWay}"
                                              OnContent="开启 / On" OffContent="关闭 / Off"/>
                                <Slider Header="音效音量&#x0a;Sound volume" Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{Binding WheelSoundVolumePercent, Mode=TwoWay}"
                                        IsEnabled="{Binding WheelSoundsEnabled, Mode=OneWay}"/>
                                <TextBlock Text="{Binding WheelSoundVolumeText, Mode=OneWay}" FontSize="12"
                                           HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="默认关闭。保存后下次打开轮盘生效；方向切换声比确认声轻。 / Off by default. Save to apply on the next opening; direction changes are quieter than confirmation."
                                           TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="回收开场 / Reclaim opening" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="打开轮盘时由远及近亮起并消散，背景同时渐灰。保存后下次打开生效；松手后的外散可与之并行。 / Blocks pulse inward as the wheel opens while the scene fades to grey. Save to apply on the next opening; outward refresh can overlap it."
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <Grid ColumnSpacing="18" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Slider Header="总时长&#x0a;Total duration"
                                                Minimum="100" Maximum="1500" StepFrequency="10"
                                                Value="{Binding ReclaimDurationMs, Mode=TwoWay}"
                                                ToolTipService.ToolTip="回收开场从开始到结束的时长，默认240ms；不会阻止已准备好的外散刷新。 / Total time for the inward opening, 240 ms by default. Ready outward refresh does not wait for it."/>
                                        <TextBlock Text="{Binding ReclaimDurationMsText, Mode=OneWay}" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Slider Header="单块持续&#x0a;Block pulse"
                                                Minimum="20" Maximum="{Binding ReclaimMaxPixelDurationMs, Mode=OneWay}" StepFrequency="10"
                                                Value="{Binding ReclaimPixelDurationMs, Mode=TwoWay}"
                                                ToolTipService.ToolTip="每块从亮起到消退的时长，默认60ms；上限为500ms且不超过总时长。 / Each block's glow-and-fade pulse, 60 ms by default. Limited to 500 ms and the total opening duration."/>
                                        <TextBlock Text="{Binding ReclaimPixelDurationMsText, Mode=OneWay}" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Slider Header="方块密度&#x0a;Block density"
                                                Minimum="10" Maximum="200" StepFrequency="5"
                                                Value="{Binding ReclaimDensityPercent, Mode=TwoWay}"
                                                ToolTipService.ToolTip="相对默认密度；100%最多600块，200%最多1200块。实际数量由屏幕大小和间距决定。 / Density relative to the default: up to 600 blocks at 100%, or 1200 at 200%. Actual count also depends on screen size and spacing."/>
                                        <TextBlock Text="{Binding ReclaimDensityPercentText, Mode=OneWay}" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Slider Header="发光强度&#x0a;Glow strength"
                                                Minimum="0" Maximum="200" StepFrequency="5"
                                                Value="{Binding ReclaimGlowPercent, Mode=TwoWay}"
                                                ToolTipService.ToolTip="仅调整方块附近柔光的强度；默认100%，0%关闭柔光并保留实心方块。 / Adjusts only the soft glow around each block. Default 100%; 0% removes the glow while keeping the solid blocks."/>
                                        <TextBlock Text="{Binding ReclaimGlowPercentText, Mode=OneWay}" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="外散刷新 / Desktop refresh" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="在轮盘中心松手播放外散刷新；保存后下次刷新生效。 / Release in the centre of the wheel to play the refresh effect. Save to apply these settings to the next refresh."
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <Slider Header="总时长&#x0a;Total duration"
                                                Minimum="600" Maximum="6000" StepFrequency="100"
                                                Value="{Binding RefreshDurationMs, Mode=TwoWay}"
                                                ToolTipService.ToolTip="外散刷新完整播放的时长；越小越快，默认2500ms。 / How long the complete refresh lasts. Lower values play the whole effect faster. The default is 2500 ms."/>
                                        <TextBlock Text="{Binding RefreshDurationMsText, Mode=OneWay}" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Slider Header="距离错峰&#x0a;Distance stagger"
                                                Minimum="0" Maximum="200" StepFrequency="5"
                                                Value="{Binding RefreshDistanceDelayPercent, Mode=TwoWay}"
                                                ToolTipService.ToolTip="深度相近时，远近像素之间的延迟；越小蔓延越快。默认100%，0%取消距离延迟。 / Delay between nearby and distant pixels at similar depth. Lower values spread faster. 100% is the default; 0% removes this distance delay."/>
                                        <TextBlock Text="{Binding RefreshDistanceDelayPercentText, Mode=OneWay}" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <Slider Header="单块持续&#x0a;Pixel duration"
                                                Minimum="25" Maximum="200" StepFrequency="5"
                                                Value="{Binding RefreshPixelDurationPercent, Mode=TwoWay}"
                                                ToolTipService.ToolTip="每个方块发光和消退的相对时长；越小越短促，默认100%。 / How long each block glows and fades, relative to the default. Lower values produce a shorter pulse. 100% is the default."/>
                                        <TextBlock Text="{Binding RefreshPixelDurationPercentText, Mode=OneWay}" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="缩短总时长和单块持续时间，可增强刷新感；动画播放中点击仍可穿透。 / For a crisper refresh, try a lower total duration and a shorter pixel pulse. Clicks pass through while the animation continues."
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================= Profiles & backup ============================= -->
                <ScrollViewer x:Name="ProfilesSection" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="20,12,20,20">
                    <StackPanel Spacing="16" MaxWidth="900">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="配置方案 / Profiles" Style="{StaticResource SectionHeaderTextStyle}" FontSize="16" TextWrapping="Wrap"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="配置方案保存全部9个按钮；为当前按钮命名保存后，可随时载入任一方案。 / A profile is a named, saved copy of all nine buttons. Save the current buttons under a name, then Load any saved profile back onto the ring."/>

                                <Border Padding="10,8" CornerRadius="6"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ActiveProfileText, Mode=OneWay}" FontWeight="SemiBold"
                                               MaxWidth="360" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding ActiveProfileText, Mode=OneWay}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="方案名称&#x0a;Profile name" Text="{Binding ProfileName, Mode=TwoWay}"
                                             PlaceholderText="工作、浏览器、设计… / Work, Browser, Design…"/>
                                    <Button Grid.Column="1" Content="保存方案 / Save profile" Command="{Binding SaveProfileCommand}" VerticalAlignment="Bottom"/>
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" Header="已存方案&#x0a;Saved profiles" ItemsSource="{Binding Profiles}"
                                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"/>
                                    <Button Grid.Column="1" Content="载入 / Load" Command="{Binding LoadProfileCommand}" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="2" Content="重命名 / Rename" Command="{Binding RenameProfileCommand}" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="3" Content="删除 / Delete" Command="{Binding DeleteProfileCommand}" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="{Binding ProfileCountText}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                                <!-- A button opening a dialog rather than an inline Expander: see the
                                     original remark this preserves - Save is blocked on a key name this
                                     app does not recognise, and Win+... can only be typed, not recorded. -->
                                <Button HorizontalAlignment="Left" Click="ShowKeyNames_Click"
                                        AutomationProperties.Name="支持的按键名称 / Recognised key names"
                                        ToolTipService.ToolTip="手动输入快捷键时支持的按键名称。 / The key names a shortcut can be typed from.">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF11C;" FontSize="14"/>
                                        <TextBlock Text="按键名称 / Key names" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="备份 / Backup" Style="{StaticResource SectionHeaderTextStyle}" FontSize="16" TextWrapping="Wrap"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="一次备份或恢复全部配置方案、触发方式、轮盘外观及提取的图标。 / Saves or restores everything at once: every profile, the trigger, the ring appearance, and extracted icons."/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="BackupAll_Click" AutomationProperties.Name="完整备份 / Backup all">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF019;" FontSize="13"/>
                                            <TextBlock Text="完整备份… / Backup all…" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="RestoreAll_Click" AutomationProperties.Name="恢复备份 / Restore backup">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF0ED;" FontSize="13"/>
                                            <TextBlock Text="恢复备份… / Restore backup…" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Full-width config path and a scrollable command row keep both languages reachable. -->
        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Padding="24,12,24,16" Spacing="10">
                <InfoBar IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                         IsClosable="True"
                         Severity="{Binding StatusSeverity, Mode=OneWay, Converter={StaticResource StatusLevelConverter}}"
                         Title="{Binding StatusTitle, Mode=OneWay}"
                         Message="{Binding StatusMessage, Mode=OneWay}"/>

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="配置文件 / Configuration file"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ConfigPath, Mode=OneWay}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" HorizontalAlignment="Right" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Width="40" Height="34" Padding="0"
                                Command="{Binding UndoCommand}"
                                AutomationProperties.Name="撤销 / Undo"
                                ToolTipService.ToolTip="撤销尚未保存的更改 / Undo (unsaved changes)">
                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF0E2;" FontSize="14"/>
                        </Button>
                        <Button Width="40" Height="34" Padding="0"
                                Command="{Binding RedoCommand}"
                                AutomationProperties.Name="重做 / Redo"
                                ToolTipService.ToolTip="重做 / Redo">
                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF01E;" FontSize="14"/>
                        </Button>
                        <Button Content="恢复默认 / Restore defaults" Command="{Binding RestoreDefaultsCommand}"/>
                        <Button Content="打开配置 / Open config file" Command="{Binding OpenConfigFileCommand}"/>
                        <Button Content="导入 XML / Import XML" Click="ImportProfile_Click"/>
                        <Button Content="导出 XML / Export XML" Click="ExportProfile_Click"/>
                        <Button Content="保存 / Save" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
